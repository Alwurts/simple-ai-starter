# Everything CI runs, once per push instead of on every commit. Branch
# deletions and tag-only pushes skip it.
zero_oid="0000000000000000000000000000000000000000"
updates_branch=""

while read -r local_ref local_oid remote_ref remote_oid; do
  case "$remote_ref" in
    refs/heads/*)
      if [ "$local_oid" != "$zero_oid" ]; then
        updates_branch=1
      fi
      ;;
  esac
done

if [ -n "$updates_branch" ]; then
  pnpm verify
fi
