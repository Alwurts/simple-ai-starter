/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "simple-ai-starter",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "simple-ai-starter",
      // Placeholder — local dev accepts it, but run `wrangler d1 create
      // simple-ai-starter` and paste the real id here before deploying.
      "database_id": "placeholder-replace-before-deploy",
      "migrations_dir": "../../packages/db/drizzle"
    }
  ],
  "durable_objects": {
    // Only OrgAgent is bound top-level. OrgChat is a facet (sub-agent) of
    // OrgAgent — it is resolved via `ctx.exports.OrgChat` (the server.ts
    // export) and shares OrgAgent's storage, so it needs neither its own
    // binding nor a migration. See the agents SDK multi-ai-chat example.
    "bindings": [{ "class_name": "OrgAgent", "name": "OrgAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OrgAgent"] }],
  // Backs the chat agent's code execution (codemode) sandbox — see
  // docs/guides/writing-agent-tools.md.
  "worker_loaders": [{ "binding": "LOADER" }],
  // Non-secret vars. Comma-separated hostnames the chat agent's read-only
  // `fetch_url` tool may GET; empty disables the fetch tool entirely.
  "vars": {
    "FETCH_ALLOWED_HOSTS": ""
  },
  // Declared (not inferred from a developer's `.dev.vars`), so `wrangler types`
  // emits a deterministic `Cloudflare.Env` — CI (which has no `.dev.vars`) and
  // local machines generate identical types. Declaring them also switches local
  // dev to warning about missing secrets instead of silently typing them away.
  // Values may be empty (e.g. `RESEND_API_KEY=` under `MOCK_SEND_EMAIL=true`).
  // After changing this list, regenerate the types: `pnpm --filter web cf-typegen`.
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "BETTER_AUTH_URL",
      "RESEND_API_KEY",
      "EMAIL_SENDER",
      "MOCK_SEND_EMAIL",
      "ORG_CHAT_PROVIDER",
      "ORG_CHAT_MODEL",
      "WORKERS_AI_API_TOKEN",
      "CF_ACCOUNT_ID",
      "OPENAI_COMPATIBLE_BASE_URL",
      "OPENAI_COMPATIBLE_API_KEY"
    ]
  }
  /**
   * Smart Placement
   * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  // "placement": {  "mode": "smart" }
  /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
  /**
   * Environment Variables
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   * Note: Use secrets to store sensitive data.
   * https://developers.cloudflare.com/workers/configuration/secrets/
   */
  // "vars": {  "MY_VARIABLE": "production_value" }
  /**
   * Static Assets
   * https://developers.cloudflare.com/workers/static-assets/binding/
   */
  // "assets": {  "directory": "./public/",  "binding": "ASSETS" }
  /**
   * Service Bindings (communicate between multiple Workers)
   * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
   */
  // "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
