/**
 * Dedicated Wrangler config for the in-workerd test worker
 * (@cloudflare/vitest-pool-workers). NEVER deployed — production uses
 * wrangler.jsonc. It exists so the Workers test pool has a worker to run against,
 * keeping the test-only fixture (TestCounter DO) and its DO migration OUT of the
 * production wrangler.jsonc and prod migration ledger.
 *
 * Read by vitest.config.ts (the `workers` project). `main` is the test entry
 * (worker-entry.ts), which mounts the Hono API for SELF-based integration tests
 * and exports the TestCounter DO for `runInDurableObject` tests.
 *
 * compatibility_date / flags mirror wrangler.jsonc so tests run under the same
 * runtime semantics as production.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "simple-ai-starter",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/workerd-test/worker-entry.ts",
  // CI has no gitignored `.dev.vars`. These match `test/helpers/auth.ts` ORIGIN
  // so `authOrigin(env.BETTER_AUTH_URL)` does not throw on undefined.
  "vars": {
    "BETTER_AUTH_SECRET": "test-secret-key-at-least-32-characters-long",
    "BETTER_AUTH_URL": "http://localhost:4011",
    "EMAIL_SENDER": "noreply@example.com",
    "MOCK_SEND_EMAIL": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "simple-ai-starter",
      // Placeholder — the test pool never deploys, so any id works locally.
      "database_id": "placeholder-replace-before-deploy",
      "migrations_dir": "../../packages/db/drizzle"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "TestCounter", "name": "TEST_COUNTER" },
      // SessionHost backs the compaction behaviour test (agents Sessions on a
      // plain DO — the smallest real seam; the pool cannot spawn Think facets).
      { "class_name": "SessionHost", "name": "SESSION_HOST" },
      // OrgChat is a facet of OrgAgent (resolved via ctx.exports.OrgChat), so —
      // as in production — only OrgAgent gets a top-level binding + migration.
      { "class_name": "OrgAgent", "name": "OrgAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TestCounter", "OrgAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["SessionHost"] }
  ]
}
