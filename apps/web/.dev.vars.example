# Copy this file to .dev.vars and fill in real values.
# .dev.vars is git-ignored and loaded automatically by Wrangler during local dev.
# In production, set these as Worker secrets: wrangler secret put <NAME>
#
# The secret NAMES are declared in apps/web/wrangler.jsonc (`secrets.required`),
# so `wrangler types` covers them without reading this file. Wrangler warns at
# local dev startup about any that are missing. Values may be empty (e.g.
# RESEND_API_KEY under MOCK_SEND_EMAIL=true).

BETTER_AUTH_SECRET=your-secret-key-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:4011

# Outbound email (Resend). For local dev set MOCK_SEND_EMAIL=true and leave
# RESEND_API_KEY empty — emails are logged instead of sent.
RESEND_API_KEY=
EMAIL_SENDER=noreply@example.com
MOCK_SEND_EMAIL=true

# ─── Org agent inference ──────────────────────────────────────────────────────
# Pick the underlying provider; unset = workers-ai (the default). Then fill the
# matching values below. ORG_CHAT_MODEL optionally overrides the model id.
#   ORG_CHAT_PROVIDER=workers-ai | openai-compatible
# ORG_CHAT_PROVIDER=
# ORG_CHAT_MODEL=

# workers-ai (default): Cloudflare account id + an API token with Workers AI
# access. Calls the OpenAI-compatible endpoint directly — no `env.AI` binding,
# so it runs under plain `wrangler dev`.
# CF_ACCOUNT_ID=
# WORKERS_AI_API_TOKEN=

# openai-compatible: any OpenAI-compatible endpoint. ORG_CHAT_MODEL is required
# (no default model) and the base URL is called directly.
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=

# ─── Agent fetch tool ─────────────────────────────────────────────────────────
# Comma-separated hostnames the chat agent's read-only fetch_url tool may GET
# (e.g. developers.cloudflare.com,example.com). Empty/unset = no fetch tool.
FETCH_ALLOWED_HOSTS=
